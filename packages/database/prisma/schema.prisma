// Advanced Analytics Models

model SymptomReport {
  id              String   @id @default(cuid())
  userId          String?
  sessionId       String?
  postId          String?
  symptoms        Json     // Array of symptoms with severity/confidence scores
  detectedSymptoms Json?   // AI-detected symptoms from posts
  location        Json?    // Geographic data (city, region, country, lat/lng)
  pincode         String?
  city            String?
  district        String?
  state           String?
  country         String?  @default("India")
  age             Int?
  gender          String?
  temperature     Float?
  duration        String?  // How long symptoms have lasted
  severity        String?  // HIGH, MEDIUM, LOW
  metadata        Json?
  reportedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  post            Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([sessionId])
  @@index([pincode])
  @@index([city])
  @@index([district])
  @@index([state])
  @@index([reportedAt])
  @@index([severity])
}

model HealthTrend {
  id             String   @id @default(cuid())
  symptom        String
  count          Int
  region         String?
  severity       String? // mild, moderate, severe
  trendDirection String? // rising, falling, stable
  percentChange  Float?
  timeWindow     String // hourly, daily, weekly
  calculatedAt   DateTime @default(now())
  metadata       Json?

  @@index([symptom])
  @@index([region])
  @@index([calculatedAt])
}

model DoctorPerformance {
  id                    String    @id @default(cuid())
  doctorId              String    @unique
  totalResponses        Int       @default(0)
  totalPatientsHelped   Int       @default(0)
  avgResponseTime       Int? // in minutes
  helpfulnessScore      Float? // 0-5 rating
  totalRatings          Int       @default(0)
  appointmentsCompleted Int       @default(0)
  appointmentsCancelled Int       @default(0)
  activeEngagementScore Float? // composite score
  lastActiveAt          DateTime?
  calculatedAt          DateTime  @default(now())
  metadata              Json?
  // New fields for enhanced analytics
  totalPostsCommented   Int       @default(0)
  totalCommentsCount    Int       @default(0)
  conversionCount       Int       @default(0) // Total profile visits from comments that led to message clicks
  curedPatientCount     Int       @default(0) // Patients who marked themselves as cured
  notYetCount           Int       @default(0) // Patients still recovering
  consultNewDoctorCount Int       @default(0) // Patients who chose to consult another doctor
  portfolioScore        Float     @default(0) // Running score based on patient outcomes
  clinicVisitCount      Int       @default(0) // Patients who clicked "Book Appointment"
  postClinicCureCount   Int       @default(0) // Patients cured after clinic visit

  @@index([doctorId])
  @@index([helpfulnessScore])
  @@index([activeEngagementScore])
  @@index([curedPatientCount])
  @@index([portfolioScore])
}

model PatientOutcome {
  id                String   @id @default(cuid())
  patientId         String
  doctorId          String?
  threadId          String?
  appointmentId     String?
  initialSymptoms   Json
  outcome           String // RESOLVED, IMPROVED, NO_CHANGE, WORSENED
  recoveryTime      Int? // in days
  followUpCount     Int      @default(0)
  satisfactionScore Float? // 1-5
  feedback          String?
  createdAt         DateTime @default(now())
  metadata          Json?

  @@index([patientId])
  @@index([doctorId])
  @@index([outcome])
  @@index([createdAt])
}

model PlatformMetrics {
  id                  String   @id @default(cuid())
  date                DateTime @unique
  totalUsers          Int      @default(0)
  activeUsers         Int      @default(0)
  newUsers            Int      @default(0)
  totalDoctors        Int      @default(0)
  activeDoctors       Int      @default(0)
  newDoctors          Int      @default(0)
  totalPosts          Int      @default(0)
  totalAppointments   Int      @default(0)
  totalSymptomReports Int      @default(0)
  avgResponseTime     Int? // in minutes
  peakUsageHour       Int?
  userRetentionRate   Float?
  doctorRetentionRate Float?
  metadata            Json?

  @@index([date])
}

model GeographicHealthData {
  id             String   @id @default(cuid())
  region         String // city, state, or country
  latitude       Float?
  longitude      Float?
  topSymptoms    Json // Array of {symptom, count}
  totalReports   Int      @default(0)
  alertLevel     String? // LOW, MEDIUM, HIGH, CRITICAL
  trendingIssues Json?
  calculatedAt   DateTime @default(now())
  metadata       Json?

  @@index([region])
  @@index([alertLevel])
  @@index([calculatedAt])
}

model DoctorRating {
  id            String   @id @default(cuid())
  doctorId      String
  patientId     String
  appointmentId String?
  threadId      String?
  rating        Float // 1-5
  helpfulness   Int? // 1-5
  communication Int? // 1-5
  expertise     Int? // 1-5
  feedback      String?
  createdAt     DateTime @default(now())

  @@index([doctorId])
  @@index([patientId])
  @@index([createdAt])
}

model ResearchDataset {
  id          String    @id @default(cuid())
  name        String
  description String?
  dataType    String // SYMPTOMS, OUTCOMES, DEMOGRAPHICS, CORRELATIONS
  filters     Json?
  recordCount Int       @default(0)
  anonymized  Boolean   @default(true)
  requestedBy String? // Institution or researcher ID
  approvedBy  String? // Admin ID
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPORTED
  exportedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  metadata    Json?

  @@index([status])
  @@index([dataType])
  @@index([createdAt])
}

model CommentConversion {
  id               String    @id @default(cuid())
  commentId        String
  doctorId         String
  patientId        String
  postId           String
  profileVisited   Boolean   @default(false)
  messageClicked   Boolean   @default(false)
  visitedAt        DateTime?
  messageClickedAt DateTime?
  createdAt        DateTime  @default(now())
  comment          Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  doctor           User      @relation("DoctorConversions", fields: [doctorId], references: [id], onDelete: Cascade)
  patient          User      @relation("PatientConversions", fields: [patientId], references: [id], onDelete: Cascade)
  post             Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([doctorId])
  @@index([patientId])
  @@index([messageClicked])
}

model PatientFeedback {
  id             String        @id @default(cuid())
  patientId      String
  doctorId       String
  conversationId String?
  appointmentId  String?
  status         String        @default("PENDING") // PENDING, CURED, NOT_YET, CONSULT_NEW_DOCTOR
  feedbackCount  Int           @default(0)
  lastFeedbackAt DateTime?
  curedAt        DateTime?
  wasClinicVisit Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  patient        User          @relation("PatientFeedbacks", fields: [patientId], references: [id], onDelete: Cascade)
  doctor         User          @relation("DoctorFeedbacks", fields: [doctorId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([lastFeedbackAt])
}

model CommunityActivity {
  id                 String    @id @default(cuid())
  communityId        String    @unique
  activityTier       String    @default("INACTIVE") // HIGHLY_ACTIVE, MODERATELY_ACTIVE, INACTIVE
  totalPosts         Int       @default(0)
  totalComments      Int       @default(0)
  totalMembers       Int       @default(0)
  avgPostsPerDay     Float     @default(0)
  avgCommentsPerPost Float     @default(0)
  lastActivityAt     DateTime?
  calculatedAt       DateTime  @default(now())
  community          Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([activityTier])
}

// New Models for Enhanced Analytics Features

model DoctorActivityMetrics {
  id                    String    @id @default(cuid())
  doctorId              String    @unique
  totalPatientsAcquired Int       @default(0)
  avgReplyTimeHours     Float?    // Average reply time in hours
  lastActiveAt          DateTime?
  dailyActivityPattern  Json?     // Activity by hour of day (0-23)
  weeklyActivityPattern Json?     // Activity by day of week
  monthlyGrowth         Json?     // Monthly patient acquisition data
  calculatedAt          DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  doctor                User      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([lastActiveAt])
}

model UserActivityLog {
  id          String   @id @default(cuid())
  userId      String
  activityType String  // MESSAGE, COMMENT, POST, PROFILE_VIEW, LOGIN
  metadata    Json?    // Additional activity data
  hourOfDay   Int      // 0-23
  dayOfWeek   Int      // 0-6 (Sunday = 0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
  @@index([hourOfDay])
  @@index([dayOfWeek])
}

model PostPriority {
  id            String   @id @default(cuid())
  postId        String   @unique
  priorityLevel String   // HIGH, MEDIUM, LOW
  urgencyScore  Float    @default(0)
  detectedSymptoms Json? // Array of detected symptoms and their weights
  calculatedAt  DateTime @default(now())
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([priorityLevel])
  @@index([urgencyScore])
}

model PatientHealthProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  // Demographics
  ageGroup              String?   // 18-25, 26-35, 36-45, 46-60, 60+
  biologicalSex         String?   // Male, Female, Other
  bloodGroup            String?   // A+, A-, B+, B-, AB+, AB-, O+, O-
  // Medical History
  preExistingConditions Json?     // Array of conditions
  currentMedications    Json?     // Array of medications
  allergies             Json?     // Array of allergies
  // Lifestyle
  smokingStatus         String?   // Never, Former, Current
  alcoholConsumption    String?   // Never, Occasional, Regular, Heavy
  activityLevel         String?   // Sedentary, Light, Moderate, Active, Very Active
  sleepHours            String?   // <6, 6-7, 7-8, 8-9, >9
  // Health Concerns
  primaryHealthConcern  String?   // Main reason for joining
  secondaryHealthConcerns Json?   // Additional concerns
  // Metadata
  completedAt           DateTime?
  lastUpdatedAt         DateTime?
  consentForDoctorView  Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeographicHealthTrend {
  id            String   @id @default(cuid())
  symptom       String
  pincode       String?
  city          String?
  district      String?
  state         String?
  country       String   @default("India")
  reportCount   Int      @default(1)
  severity      String?  // HIGH, MEDIUM, LOW
  timeWindow    String   // daily, weekly, monthly
  calculatedAt  DateTime @default(now())
  periodStart   DateTime
  periodEnd     DateTime

  @@index([symptom])
  @@index([pincode])
  @@index([city])
  @@index([district])
  @@index([state])
  @@index([timeWindow])
  @@index([calculatedAt])
}

// Health Profile and Diet Planner Models

model HealthProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  // Basic Bio
  ageGroup                String? // 18-25, 26-35, 36-45, 46-60, 60+
  biologicalSex           String? // Male, Female, Other
  nationality             String? // Indian, Middle Eastern, East Asian, Western, African, Latin American
  weightRange             String? // Under 50kg, 50-70kg, 70-90kg, 90-110kg, 110kg+
  heightRange             String? // Under 150cm, 150-165cm, 165-180cm, 180cm+
  activityLevel           String? // Sedentary, Lightly Active, Moderately Active, Very Active
  // Medical Conditions
  medicalConditions       Json? // Array of conditions
  currentMedications      String? // Free text
  foodAllergies           Json? // Array of allergies
  // Dietary Preferences
  dietType                String? // Vegetarian, Vegan, Non-Vegetarian, Eggetarian, Pescatarian
  religiousRestrictions   String? // Halal, Kosher, Hindu Vegetarian, No restrictions
  foodsToAvoid            String? // Free text
  cookingAccess           String? // Full kitchen, Basic cooking, No cooking
  // Health Goals
  primaryGoal             String? // Weight loss, Weight gain, Maintain weight, Manage medical condition, General wellness
  sleepHours              String? // Less than 5, 5-7, 7-9, More than 9
  waterIntake             String? // Less than 1L, 1-2L, 2-3L, More than 3L
  // Metadata
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietPlans               DietPlan[]

  @@index([userId])
}

model DietPlan {
  id                String        @id @default(cuid())
  userId            String
  healthProfileId   String
  dailyCalorieGoal  Int
  planData          Json // Full meal plan with breakfast, lunch, snack, dinner
  nutritionalInfo   Json // Macro breakdown, highlights
  dietaryNote       String? // Condition-specific adjustments note
  generatedAt       DateTime      @default(now())
  savedAt           DateTime?
  isActive          Boolean       @default(false)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthProfile     HealthProfile @relation(fields: [healthProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([healthProfileId])
  @@index([generatedAt])
}
