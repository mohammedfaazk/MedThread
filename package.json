{
  "name": "medthread",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "cd packages/database && prisma generate",
    "db:push": "cd packages/database && prisma db push"
  },
  "devDependencies": {
    "turbo": "^1.11.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.7.0",
    "@types/nodemailer": "^7.0.10",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "stripe": "^20.3.1"
  }
}
